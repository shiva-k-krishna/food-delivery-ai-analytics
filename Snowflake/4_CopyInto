USE ROLE ACCOUNTADMIN;
USE DATABASE FOOD_DELIVERY;

--food
COPY INTO FOOD_DELIVERY.RAW.FOOD FROM @FOOD_DELIVERY.RAW.CSV_STAGE/food.csv  ON_ERROR = 'CONTINUE';

--menu
COPY INTO FOOD_DELIVERY.RAW.menu FROM @FOOD_DELIVERY.RAW.CSV_STAGE/menu.csv  ON_ERROR = 'CONTINUE';

--order_items
COPY INTO FOOD_DELIVERY.RAW.order_items FROM @FOOD_DELIVERY.RAW.CSV_STAGE/order_items.csv ON_ERROR = 'ABORT_STATEMENT';

--orders
COPY INTO FOOD_DELIVERY.RAW.orders FROM @FOOD_DELIVERY.RAW.CSV_STAGE/orders.csv ON_ERROR = 'ABORT_STATEMENT';

--restaurant
COPY INTO FOOD_DELIVERY.RAW.restaurant FROM @FOOD_DELIVERY.RAW.CSV_STAGE/restaurant.csv ON_ERROR = 'CONTINUE' ;

--reviews
COPY INTO FOOD_DELIVERY.RAW.reviews FROM @FOOD_DELIVERY.RAW.CSV_STAGE/reviews.csv ON_ERROR = 'ABORT_STATEMENT';

--USERS
COPY INTO FOOD_DELIVERY.RAW.USERS FROM @FOOD_DELIVERY.RAW.CSV_STAGE/users.csv ON_ERROR = 'CONTINUE';



--table inspection after loading data 
SELECT 'USERS' AS TABLE_NAME, COUNT(*) AS ROW_COUNT FROM FOOD_DELIVERY.RAW.USERS
UNION ALL   SELECT 'FOOD',          COUNT(*) FROM FOOD_DELIVERY.RAW.FOOD
UNION ALL   SELECT 'MENU',          COUNT(*) FROM FOOD_DELIVERY.RAW.MENU
UNION ALL   SELECT 'RESTAURANT',    COUNT(*) FROM FOOD_DELIVERY.RAW.RESTAURANT
UNION ALL   SELECT 'ORDERS',        COUNT(*) FROM FOOD_DELIVERY.RAW.ORDERS
UNION ALL   SELECT 'ORDER_ITEMS',   COUNT(*) FROM FOOD_DELIVERY.RAW.ORDER_ITEMS
UNION ALL   SELECT 'REVIEWS',       COUNT(*) FROM FOOD_DELIVERY.RAW.REVIEWS
;



